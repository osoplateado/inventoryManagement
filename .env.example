# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real secrets.

# Postgres connection (use DATABASE_URL, or the DB_* vars below)
DATABASE_URL=
# DB_HOST=
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
# DB_PORT=5432
DATABASE_SSL=true

OPENAI_API_KEY=

PORT=3000
