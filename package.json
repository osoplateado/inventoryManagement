{
  "name": "inventory-management",
  "version": "1.0.0",
  "private": true,
  "description": "Shipping container inventory dashboard with a React + Vite frontend and Node + PostgreSQL backend",
  "main": "server.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "dev:server": "nodemon server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "import-sql": "node import-sql.js",
    "delete-by-vendor": "node scripts/delete-by-vendor.js",
    "normalize-locations": "node scripts/normalize-locations.js",
    "fix-bare-locations": "node scripts/fix-bare-locations.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "express": "^4.18.2",
    "openai": "^4.11.0",
    "pg": "^8.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.3",
    "jsdom": "^30.0.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "vite": "^5.4.21",
    "vitest": "^4.1.10"
  }
}
